# Local development uses Vite's /api proxy, which forwards to this target.
LOGITRACK_API_PROXY_TARGET=http://127.0.0.1:8000
# Optional when the readiness endpoint differs from the proxy target.
# LOGITRACK_API_HEALTH_URL=http://127.0.0.1:8000/health

# Leave unset for local development. For a deployed static frontend, set this at build time
# to the public FastAPI URL (for example, https://predictions.example.com).
# VITE_PREDICTION_API_URL=https://predictions.example.com
